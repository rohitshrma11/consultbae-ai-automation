    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nconst item = $input.first();\nconst body = item.json.body || {};\n\n// Name clean\nconst name = String(body.name || \"\")\n  .trim()\n  .toLowerCase()\n  .replace(/\\b\\w/g, c => c.toUpperCase());\n\n// Email clean\nconst email = String(body.email || \"\")\n  .trim()\n  .toLowerCase();\n\n// Phone clean\nlet phone = String(body.phone || \"\")\n  .replace(/\\D/g, \"\");\n\nif (phone.length === 12 && phone.startsWith(\"91\")) {\n  phone = phone.substring(2);\n}\n\nif (phone.length > 10) {\n  phone = phone.slice(-10);\n}\n\n// City clean\nconst cityRaw = String(body.city || \"\")\n  .trim()\n  .toLowerCase();\n\nconst cityMapping = {\n  \"gurgaon\": \"Gurugram\",\n  \"gurugram\": \"Gurugram\",\n  \"bangalore\": \"Bengaluru\",\n  \"bengaluru\": \"Bengaluru\",\n  \"new delhi\": \"Delhi\",\n  \"delhi ncr\": \"Delhi\",\n  \"delhi\": \"Delhi\",\n  \"noida\": \"Noida\",\n  \"pune\": \"Pune\"\n};\n\nconst city =\n  cityMapping[cityRaw] ||\n  cityRaw.replace(/\\b\\w/g, c => c.toUpperCase());\n\nreturn [\n  {\n    json: {\n      name: name,\n      email: email,\n      phone: phone,\n      city: city\n    }\n  }\n];"
      },
